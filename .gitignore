# DS4Arduino .gitignore — everything below stays out of the repo.
# Source of truth is human-written code, docs, art and examples.

# --- Arduino build outputs (regenerated by Compile) ---
*.elf
*.hex
*.bin
*.map
build/
*.d

# --- ESP-IDF / PlatformIO generated state ---
sdkconfig
sdkconfig.old
sdkconfig.defaults.generated
dependencies.lock
managed_components/
.pio/
.pioenvs/
boot_app0.bin

# --- Python / Node scratch tooling ---
__pycache__/
*.py[cod]
.venv/
node_modules/
package-lock.json

# --- Editors, IDE private state, OS droppings ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Local captures: serial logs, flash dumps, screenshots ---
*.log
*.dump
serial-*.txt
screenshot*.png
